{
  "name": "cockpit-pro-desktop",
  "productName": "Cockpit Pro",
  "version": "0.2.0",
  "private": true,
  "description": "Offline Boeing 737 Classic cockpit and systems trainer (educational; not for flight)",
  "main": "main.cjs",
  "author": "Cockpit Pro Project",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "check": "node --check main.cjs",
    "test": "node --test *.test.cjs",
    "smoke:win": "node smoke-native.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.cockpitpro.b737classic",
    "productName": "Cockpit Pro",
    "copyright": "Cockpit Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.cjs",
      "package.json",
      "!*.test.cjs",
      "!smoke-native.cjs"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../",
        "to": "app-content",
        "filter": [
          "**/*",
          "!.git/**",
          "!.github/**",
          "!desktop/**",
          "!**/node_modules/**",
          "!**/.DS_Store",
          "!**/Thumbs.db",
          "!.openai/**",
          "!preview/**",
          "!tests/**",
          "!tools/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "CockpitPro",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cockpit Pro",
      "artifactName": "CockpitPro-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mahmet737ng-gif",
        "repo": "b737-classic-simulator",
        "releaseType": "release"
      }
    ],
    "compression": "normal"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
