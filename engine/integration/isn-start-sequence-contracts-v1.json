    {"from": "SOURCE_OBSERVATION.engine2.running", "to": "ISN-03.engine2.running", "reference": "ISN-03 Stage 1 / FCOM 6.20.1-4 and 2.20.1-2", "kind": "EXPLICIT_OBSERVATION"},
    {"from": "SOURCE_OBSERVATION.apu.running", "to": "ISN-03.apu.running", "reference": "ISN-03 Stage 1 / FCOM 6.20.1-4 and 2.20.1-2", "kind": "EXPLICIT_OBSERVATION"},
    {"from": "ENGINE_START_SWITCH.GRD + POWER_FEEDBACK.batteryBusPowered", "to": "engine.startValveOpenCommand", "reference": "FCOM 7.20.7 PDF1208", "kind": "FCOM_FUNCTIONAL_COMMAND"},
    {"from": "ENGINE_START_SWITCH.GRD + FEEDBACK.n2Percent >= 46", "to": "ENGINE_START_SWITCH.OFF", "reference": "FCOM 7.20.7 PDF1208 + NP.21.35 PDF135", "kind": "FCOM_APPROXIMATE_DISCRETE_CUTOUT"},
    {"from": "FEEDBACK.n1RotationObserved + FEEDBACK.n2Percent + FEEDBACK.maxMotoringObserved", "to": "engine.fuel.recommendMovingLeverToIdle", "reference": "FCOM NP.21.34 PDF134", "kind": "PROCEDURAL_RECOMMENDATION_ONLY"},
    {"from": "ENGINE_START_SWITCH + IGNITION_SELECTOR + FEEDBACK.fuelStartLever + POWER_FEEDBACK.AC", "to": "engine.ignition.supplyEligible", "reference": "FCOM 7.10.22 + 7.20.8", "kind": "FUNCTIONAL_ELIGIBILITY_NOT_ACTUAL_IGNITION"},
    {"from": "Ground start + FEEDBACK.egtC >= 725", "to": "engine.advisory.egt725Latched", "reference": "FCOM 7.20.7 PDF1208", "kind": "ABNORMAL_START_CRITERION_ONLY"},
    {"from": "APU_SWITCH.START + POWER_FEEDBACK + FEEDBACK.fireHandles", "to": "apu.inletDoorOpenCommand", "reference": "FCOM 7.30.2 PDF1217", "kind": "FUNCTIONAL_COMMAND_NOT_DOOR_POSITION"},
    {"from": "APU_SWITCH.OFF", "to": "selectedAPUGenerators.OFF + apuBleed.OFF", "reference": "FCOM 7.30.3 PDF1218", "kind": "FCOM_DISCRETE_COMMAND"},
    {"from": "Observed ground + battery switch OFF or cockpit APU fire handle OUT", "to": "APU.SHUTDOWN_REQUEST + selectedAPUGenerators.OFF + apuBleed.OFF", "reference": "FCOM 7.30.2-3 PDF1217-1218", "kind": "FCOM_CONDITIONAL_SHUTDOWN_COMMAND"}
